{
  "name": "community-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run seo:images && npm run seo:sitemap && npm run seo:generate && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:sitemap": "node --test scripts/generate-sitemap.test.mjs",
    "seo:generate": "node scripts/generate-seo-artifacts.mjs",
    "seo:images": "node scripts/optimize-public-images.mjs",
    "seo:sitemap": "node scripts/generate-sitemap.mjs"
  },
  "private": true,
  "packageManager": "npm@11.14.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "21.2.25",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.27",
    "@supabase/supabase-js": "^2.118.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "fflate": "^0.8.3",
    "read-excel-file": "^9.3.17",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.27",
    "@angular/cli": "^21.2.27",
    "@angular/compiler-cli": "^21.2.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "sharp": "^0.35.5",
    "supabase": "^2.121.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
