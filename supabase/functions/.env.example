# Load these ONLY as Edge Function secrets, never Angular/Cloudflare browser vars.
OPENAI_API_KEY=replace-with-a-project-scoped-key
AI_SEARCH_MODEL=gpt-4.1-nano-2025-04-14
AI_SEARCH_ALLOWED_ORIGINS=http://localhost:4200,https://your-app.pages.dev
# Public browser key matching the existing Angular configuration. Not a service key.
AI_SEARCH_PUBLIC_KEY=replace-with-your-supabase-publishable-key
# SUPABASE_URL and SUPABASE_ANON_KEY are supplied by the Supabase runtime.
